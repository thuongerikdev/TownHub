Nhóm Mua sắm được đặc tả bằng chín use case đầy đủ, đi theo chuỗi \emph{Procure-to-Pay}: từ quản lý kho -- vật tư, giao dịch tồn kho, kiểm kê, đến PR $\rightarrow$ PO $\rightarrow$ nhận hàng $\rightarrow$ hóa đơn/OCR $\rightarrow$ thanh toán, và quản lý nhà cung cấp.

\begin{ucspec}{UC-M01 — Quản lý danh mục kho \& vật tư}
\ucrow{Mục đích}{Khai báo kho, loại vật tư và vật tư kèm ngưỡng tồn tối thiểu/điểm đặt hàng lại.}
\ucrow{Tác nhân}{Kỹ sư trưởng (kế thừa KTV).}
\ucrow{Tiền điều kiện}{Đã đăng nhập với quyền quản lý kho.}
\ucrow{Luồng chính}{%
1.\ Tạo/sửa \texttt{warehouses} và \texttt{material\_categories}.\newline
2.\ Tạo/sửa \texttt{materials} kèm đơn vị tính, mức tồn tối thiểu và điểm đặt hàng lại.\newline
3.\ Hệ thống khởi tạo \texttt{inventory\_levels} tương ứng theo kho.}
\ucrow{Luồng ngoại lệ}{E1.\ Mã vật tư trùng $\rightarrow$ báo lỗi. E2.\ Ngưỡng tồn/đơn giá âm $\rightarrow$ chặn khi lưu.}
\ucrow{Hậu điều kiện}{Danh mục vật tư sẵn sàng cho giao dịch kho và mua sắm.}
\ucrow{Quy tắc nghiệp vụ}{Màn Tồn kho chỉ đọc; thao tác CRUD vật tư dồn về Danh mục vật tư.}
\end{ucspec}

\begin{ucspec}{UC-M02 — Ghi giao dịch kho \& cảnh báo tồn thấp}
\ucrow{Mục đích}{Ghi nhận nhập/xuất/điều chỉnh/điều chuyển và cảnh báo khi tồn dưới ngưỡng.}
\ucrow{Tác nhân}{Kỹ thuật viên (ghi giao dịch); Kỹ sư trưởng (điều chuyển).}
\ucrow{Tiền điều kiện}{Vật tư và kho đã khai báo.}
\ucrow{Luồng chính}{%
1.\ Chọn loại giao dịch và vật tư, nhập số lượng; hệ thống sinh mã giao dịch phía máy chủ.\newline
2.\ Cập nhật \texttt{inventory\_levels}; ghi \texttt{inventory\_transactions}.\newline
3.\ Nếu tồn xuống dưới mức tối thiểu $\rightarrow$ đưa vào danh sách cảnh báo tồn thấp (\texttt{get-low-stock}).}
\ucrow{Luồng ngoại lệ}{E1.\ Xuất vượt tồn $\rightarrow$ chặn gửi. E2.\ Thông tin người/mã dạng chữ ghi vào \texttt{notes}, không ghi vào trường kiểu \texttt{Guid}.}
\ucrow{Hậu điều kiện}{Tồn kho được cập nhật; giao dịch lưu vết đầy đủ.}
\ucrow{Quy tắc nghiệp vụ}{Mã giao dịch do máy chủ sinh (tránh trùng); không cho số lượng âm.}
\end{ucspec}

\begin{ucspec}{UC-M03 — Kiểm kê kho (stock take)}
\ucrow{Mục đích}{Đối chiếu tồn thực tế với sổ sách theo kỳ và sinh giao dịch điều chỉnh.}
\ucrow{Tác nhân}{Kỹ sư trưởng.}
\ucrow{Tiền điều kiện}{Có tồn kho cần kiểm kê.}
\ucrow{Luồng chính}{%
1.\ Mở kỳ kiểm kê \texttt{stock\_takes}; chọn người thực hiện từ danh sách.\newline
2.\ Nhập số đếm thực tế cho từng vật tư (\texttt{stock\_take\_lines}).\newline
3.\ Với chênh lệch, sinh giao dịch điều chỉnh tham chiếu \texttt{Guid} phiếu kiểm kê; lưu lịch sử kiểm kê.}
\ucrow{Luồng ngoại lệ}{E1.\ Kỳ khớp sổ (không lệch) $\rightarrow$ không sinh giao dịch nhưng vẫn lưu dấu vết kỳ.}
\ucrow{Hậu điều kiện}{Tồn kho khớp thực tế; mọi kỳ kiểm kê có lịch sử tra cứu.}
\ucrow{Quy tắc nghiệp vụ}{Người thực hiện chọn từ danh sách (không nhập tay); tham chiếu phiếu bằng \texttt{Guid}.}
\end{ucspec}

\begin{ucspec}{UC-M04 — Lập \& duyệt đề nghị mua (PR)}
\ucrow{Mục đích}{Đề xuất mua vật tư và duyệt theo nguyên tắc tách bạch nhiệm vụ.}
\ucrow{Tác nhân}{KTV/Kỹ sư trưởng (lập); Ban quản lý (duyệt).}
\ucrow{Tiền điều kiện}{Đã đăng nhập; có nhu cầu mua (có thể phát sinh từ ticket/WO).}
\ucrow{Luồng chính}{%
1.\ Lập PR + dòng vật tư (\texttt{DRAFT}).\newline
2.\ Gửi duyệt (\texttt{SUBMITTED}).\newline
3.\ Ban quản lý duyệt (\texttt{APPROVED}) hoặc từ chối (\texttt{REJECTED}, kèm lý do).}
\ucrow{Luồng ngoại lệ}{E1.\ Người đề xuất tự duyệt PR của mình $\rightarrow$ chặn \texttt{403} (tách bạch nhiệm vụ). E2.\ Duyệt PR chưa ở \texttt{SUBMITTED} $\rightarrow$ chặn. E3.\ Từ chối không nhập lý do $\rightarrow$ chặn.}
\ucrow{Hậu điều kiện}{PR \texttt{APPROVED} là căn cứ tạo đơn mua (PO).}
\ucrow{Quy tắc nghiệp vụ}{Vòng đời PR theo Hình 4.4; nút duyệt/từ chối có busy-state chống double-submit.}
\end{ucspec}

\begin{ucspec}{UC-M05 — Tạo \& duyệt đơn mua (PO)}
\ucrow{Mục đích}{Chuyển PR đã duyệt thành đơn mua gửi nhà cung cấp.}
\ucrow{Tác nhân}{Kỹ sư trưởng/Ban quản lý (tạo); Ban quản lý (duyệt PO).}
\ucrow{Tiền điều kiện}{Có PR ở trạng thái \texttt{APPROVED}.}
\ucrow{Luồng chính}{%
1.\ Tạo \texttt{purchase\_orders} + dòng từ PR, chọn nhà cung cấp và đơn giá.\newline
2.\ Gửi duyệt PO qua \texttt{po\_approval\_workflow}.\newline
3.\ Ban quản lý duyệt; PO sẵn sàng để nhận hàng.}
\ucrow{Luồng ngoại lệ}{E1.\ PO không gắn PR đã duyệt $\rightarrow$ chặn tạo.}
\ucrow{Hậu điều kiện}{PO đã duyệt, chờ nhận hàng và hóa đơn.}
\ucrow{Quy tắc nghiệp vụ}{Chuỗi PR $\rightarrow$ PO bảo đảm mọi khoản mua đều có căn cứ đề xuất được duyệt.}
\end{ucspec}

\begin{ucspec}{UC-M06 — Nhận hàng \& nhập kho từ PO}
\ucrow{Mục đích}{Nhập vật tư về kho theo PO và tăng tồn.}
\ucrow{Tác nhân}{Kỹ thuật viên/Kỹ sư trưởng.}
\ucrow{Tiền điều kiện}{Có PO đã duyệt và hàng về.}
\ucrow{Luồng chính}{%
1.\ Đối chiếu hàng nhận với dòng PO.\newline
2.\ Ghi giao dịch nhập kho (\texttt{IN}), tồn tăng.\newline
3.\ Cập nhật tiến độ nhận của PO.}
\ucrow{Luồng ngoại lệ}{E1.\ Nhận thiếu/thừa so với PO $\rightarrow$ ghi nhận chênh lệch để đối chiếu hóa đơn.}
\ucrow{Hậu điều kiện}{Tồn kho tăng; PO có bản ghi nhận hàng.}
\ucrow{Quy tắc nghiệp vụ}{Giao dịch nhập tham chiếu PO để phục vụ đối chiếu ba bên PO--nhận--hóa đơn.}
\end{ucspec}

\begin{ucspec}{UC-M07 — OCR hóa đơn}
\ucrow{Mục đích}{Số hóa hóa đơn giấy bằng OCR để giảm nhập liệu tay.}
\ucrow{Tác nhân}{Kế toán.}
\ucrow{Tiền điều kiện}{Có ảnh hóa đơn giấy/chụp (định dạng và kích thước hợp lệ).}
\ucrow{Luồng chính}{%
1.\ Nộp ảnh và chọn engine (\texttt{paddleocr}/\texttt{vietocr}); tạo job \texttt{QUEUED}.\newline
2.\ Worker nền lấy job (\texttt{PROCESSING}), gọi dịch vụ Python bóc tách văn bản + độ tin cậy.\newline
3.\ Lưu kết quả (\texttt{COMPLETED}); kế toán đối chiếu với PO rồi đánh dấu đã duyệt (\texttt{REVIEWED}).}
\ucrow{Luồng ngoại lệ}{E1.\ Lỗi engine $\rightarrow$ \texttt{FAILED} (ghi \texttt{errorMessage}). E2.\ Tệp quá \texttt{10MB} hoặc sai định dạng $\rightarrow$ chặn tải lên.}
\ucrow{Hậu điều kiện}{Kết quả OCR gắn với hóa đơn (xem trạng thái ở Hình 4.5).}
\ucrow{Quy tắc nghiệp vụ}{Xử lý bất đồng bộ qua hàng đợi để không chặn giao diện; chi tiết mô hình ở §4.4.}
\end{ucspec}

\begin{ucspec}{UC-M08 — Nhập, đối chiếu hóa đơn \& đánh dấu thanh toán}
\ucrow{Mục đích}{Ghi nhận hóa đơn, đối chiếu với PO và xác nhận đã thanh toán.}
\ucrow{Tác nhân}{Kế toán.}
\ucrow{Tiền điều kiện}{Có PO/nhận hàng tương ứng (có thể kèm kết quả OCR).}
\ucrow{Luồng chính}{%
1.\ Tạo \texttt{invoices} + \texttt{invoice\_items} (nhập tay hoặc từ OCR).\newline
2.\ Đối chiếu số lượng/đơn giá với PO.\newline
3.\ Đánh dấu thanh toán (\texttt{PAID}) kèm ngày thanh toán, mã giao dịch, ghi chú.}
\ucrow{Luồng ngoại lệ}{E1.\ Lệch với PO $\rightarrow$ giữ chờ, không cho đánh dấu thanh toán. E2.\ Số lượng/đơn giá âm $\rightarrow$ chặn.}
\ucrow{Hậu điều kiện}{Hóa đơn ở trạng thái \texttt{PAID}, khép vòng P2P.}
\ucrow{Quy tắc nghiệp vụ}{Xác nhận thanh toán nhận ngày thanh toán + ghi chú; không ghi chuỗi tự do vào trường kiểu \texttt{Guid}.}
\end{ucspec}

\begin{ucspec}{UC-M09 — Quản lý nhà cung cấp, hợp đồng \& đánh giá}
\ucrow{Mục đích}{Quản lý hồ sơ nhà cung cấp, hợp đồng dịch vụ và đánh giá chất lượng.}
\ucrow{Tác nhân}{Ban quản lý.}
\ucrow{Tiền điều kiện}{Đã đăng nhập với quyền quản lý nhà cung cấp.}
\ucrow{Luồng chính}{%
1.\ Tạo/sửa \texttt{vendors} và \texttt{vendor\_contracts} + \texttt{vendor\_contract\_services}.\newline
2.\ Sau mỗi kỳ mua/cung ứng, ghi \texttt{vendor\_evaluations}.\newline
3.\ Dùng đánh giá làm căn cứ chọn nhà cung cấp cho PO.}
\ucrow{Luồng ngoại lệ}{E1.\ Hợp đồng hết hạn $\rightarrow$ cảnh báo khi tạo PO cho nhà cung cấp đó.}
\ucrow{Hậu điều kiện}{Hồ sơ nhà cung cấp/hợp đồng/đánh giá được cập nhật.}
\ucrow{Quy tắc nghiệp vụ}{Đánh giá gắn với nhà cung cấp phục vụ ra quyết định mua sắm.}
\end{ucspec}

