\subsection*{3.3.1. Đặc tả use case Base tiêu biểu}
\addcontentsline{toc}{subsection}{3.3.1. Đặc tả use case Base tiêu biểu}
Mỗi use case tiêu biểu của Base được đặc tả theo mẫu \emph{đầy đủ} (fully-dressed): mục đích, tác nhân, tiền điều kiện, luồng chính (đánh số bước), luồng thay thế, luồng ngoại lệ, hậu điều kiện và quy tắc nghiệp vụ. Tám use case dưới đây phủ ba cụm chức năng của Base ở các Hình 3.4a--3.4c.

\begin{ucspec}{UC-B01 — Đăng nhập có xác thực đa yếu tố (MFA)}
\ucrow{Mục đích}{Xác thực người dùng và cấp JWT mang đầy đủ vai trò/quyền để truy cập hệ thống.}
\ucrow{Tác nhân}{Người dùng mọi vai trò (cư dân qua \texttt{/login/userLogin}; nhân sự qua \texttt{/login/StaffLogin}).}
\ucrow{Tiền điều kiện}{Tài khoản ở trạng thái \texttt{Active}, đã xác minh email.}
\ucrow{Kích hoạt}{Người dùng gửi biểu mẫu đăng nhập.}
\ucrow{Luồng chính}{%
1.\ Người dùng nhập \texttt{userName} và mật khẩu.\newline
2.\ Hệ thống kiểm tra \texttt{status=Active}, verify mật khẩu (đã băm) và cờ \texttt{isEmailVerified}.\newline
3.\ Nếu tài khoản bật MFA: sinh vé \texttt{mfa:login:\{ticket\}} lưu Redis (TTL 5 phút), trả \texttt{requiresMfa=true} (chưa cấp token).\newline
4.\ Người dùng nhập mã TOTP 6 số.\newline
5.\ Hệ thống xác minh TOTP (OtpNet, $\pm$1 window).\newline
6.\ Tạo phiên \texttt{AuthUserSession}, phát JWT HS256 (claims \texttt{role}/\texttt{permission}) và refresh token, đặt cookie HttpOnly.}
\ucrow{Luồng thay thế}{A1.\ Tài khoản không bật MFA: bỏ bước 3--5, cấp token ngay sau bước 2.}
\ucrow{Luồng ngoại lệ}{E1.\ Sai mật khẩu $\rightarrow$ \texttt{401}. E2.\ Email chưa xác minh $\rightarrow$ \texttt{409}. E3.\ Tài khoản bị khoá $\rightarrow$ \texttt{403}. E4.\ TOTP sai $\rightarrow$ \texttt{401}. E5.\ Vé MFA hết hạn $\rightarrow$ \texttt{400} (đăng nhập lại).}
\ucrow{Hậu điều kiện}{Có phiên hợp lệ; JWT chứa đầy đủ vai trò/quyền phục vụ RBAC ở mỗi request.}
\ucrow{Quy tắc nghiệp vụ}{Mật khẩu chỉ lưu dạng băm; chỉ MFA ở trạng thái \texttt{Enabled} mới chấp nhận mã; JWT hết hạn ngắn, gia hạn qua refresh token xoay vòng.}
\end{ucspec}

\begin{ucspec}{UC-B02 — Thiết lập \& quản lý xác thực hai yếu tố (TOTP)}
\ucrow{Mục đích}{Cho phép người dùng bật/tắt MFA để tăng cường bảo mật tài khoản.}
\ucrow{Tác nhân}{Người dùng đã đăng nhập (chủ tài khoản).}
\ucrow{Tiền điều kiện}{Đã đăng nhập; MFA đang ở \texttt{Disabled} hoặc chưa thiết lập.}
\ucrow{Luồng chính}{%
1.\ Người dùng chọn ``Bật MFA''; hệ thống sinh bí mật TOTP và mã QR, tạo \texttt{AuthMfaSecret} trạng thái \texttt{Pending}.\newline
2.\ Người dùng quét mã QR bằng ứng dụng Authenticator và nhập mã TOTP xác nhận.\newline
3.\ Hệ thống xác minh mã; nếu đúng chuyển trạng thái sang \texttt{Enabled}.}
\ucrow{Luồng thay thế}{A1.\ Tắt MFA: người dùng xác nhận $\rightarrow$ trạng thái chuyển \texttt{Disabled}, có thể bật lại sau.}
\ucrow{Luồng ngoại lệ}{E1.\ Mã xác nhận sai $\rightarrow$ giữ nguyên \texttt{Pending}, yêu cầu nhập lại.}
\ucrow{Hậu điều kiện}{MFA ở \texttt{Enabled}; các lần đăng nhập sau yêu cầu mã TOTP (xem Hình 3.7).}
\ucrow{Quy tắc nghiệp vụ}{Chỉ một bí mật TOTP còn hiệu lực trên mỗi tài khoản (quan hệ 1--1).}
\end{ucspec}

\begin{ucspec}{UC-B03 — Làm mới token \& quản lý phiên đa thiết bị}
\ucrow{Mục đích}{Duy trì đăng nhập liền mạch và cho phép thu hồi phiên trên từng thiết bị.}
\ucrow{Tác nhân}{Người dùng đã đăng nhập (thu hồi phiên của bản thân); Quản trị viên (thu hồi phiên bất kỳ).}
\ucrow{Tiền điều kiện}{Có phiên hợp lệ và refresh token còn hạn.}
\ucrow{Luồng chính}{%
1.\ Khi JWT hết hạn, client gửi refresh token.\newline
2.\ Hệ thống đối chiếu \texttt{AuthRefreshToken} (còn hạn, chưa thu hồi), xoay vòng token (cấp token mới, vô hiệu token cũ) và phát JWT mới.\newline
3.\ Người dùng xem danh sách phiên \texttt{AuthUserSession} theo thiết bị và có thể đăng xuất một phiên.}
\ucrow{Luồng thay thế}{A1.\ Đăng xuất toàn bộ: thu hồi mọi phiên và refresh token của tài khoản.}
\ucrow{Luồng ngoại lệ}{E1.\ Refresh token hết hạn/đã thu hồi $\rightarrow$ \texttt{401}, buộc đăng nhập lại.}
\ucrow{Hậu điều kiện}{Phiên bị thu hồi không còn làm mới được token.}
\ucrow{Quy tắc nghiệp vụ}{Refresh token dùng một lần (rotation); thu hồi phiên là tức thời cho lần làm mới kế tiếp.}
\end{ucspec}

\begin{ucspec}{UC-B04 — Quản lý tài khoản người dùng}
\ucrow{Mục đích}{Tạo, cập nhật, khoá/mở khoá tài khoản người dùng và hồ sơ đi kèm.}
\ucrow{Tác nhân}{Quản trị viên.}
\ucrow{Tiền điều kiện}{Đã đăng nhập với quyền quản trị người dùng.}
\ucrow{Luồng chính}{%
1.\ Quản trị viên tạo \texttt{AuthUser} + \texttt{AuthProfile} (1--1), gán vai trò khởi tạo.\newline
2.\ Cập nhật thông tin, đặt lại mật khẩu, hoặc khoá/mở khoá (đổi \texttt{status}).\newline
3.\ Danh sách người dùng được tách theo phạm vi: cư dân và nhân sự truy vấn qua hai endpoint riêng.}
\ucrow{Luồng ngoại lệ}{E1.\ \texttt{userName}/email trùng $\rightarrow$ báo lỗi trùng. E2.\ Khoá tài khoản đang đăng nhập $\rightarrow$ các phiên hết hiệu lực ở lần làm mới token.}
\ucrow{Hậu điều kiện}{Tài khoản được tạo/cập nhật; thay đổi được ghi Audit log (UC-B08).}
\ucrow{Quy tắc nghiệp vụ}{Mỗi \texttt{AuthUser} có đúng một \texttt{AuthProfile}; không xoá cứng tài khoản có dữ liệu liên quan (khoá thay vì xoá).}
\end{ucspec}

\begin{ucspec}{UC-B05 — Gán vai trò \& gán quyền (RBAC)}
\ucrow{Mục đích}{Cấu hình ma trận phân quyền: người dùng$\leftrightarrow$vai trò và vai trò$\leftrightarrow$quyền.}
\ucrow{Tác nhân}{Quản trị viên.}
\ucrow{Tiền điều kiện}{Đã có danh mục vai trò (\texttt{AuthRole}) và quyền (\texttt{AuthPermission}).}
\ucrow{Luồng chính}{%
1.\ Gán tập vai trò cho người dùng (\texttt{RoleAssign} $\rightarrow$ \texttt{AuthUserRole}).\newline
2.\ Gán tập quyền cho vai trò (\texttt{PermissionAssign} $\rightarrow$ \texttt{AuthRolePermission}).\newline
3.\ Ở lần đăng nhập/làm mới token kế tiếp, hệ thống truy vấn lại tập quyền mới nhất và nhúng \texttt{code} quyền vào JWT.}
\ucrow{Luồng ngoại lệ}{E1.\ Gỡ vai trò/quyền đang dùng $\rightarrow$ hiệu lực ở token phát hành kế tiếp, không thu hồi token đang còn hạn.}
\ucrow{Hậu điều kiện}{Người dùng có tập quyền mới; RBAC thực thi ở mỗi request (Hình 3.6).}
\ucrow{Quy tắc nghiệp vụ}{Quyền hiệu lực bằng token; token cũ còn hạn vẫn mang quyền cũ cho tới khi làm mới.}
\end{ucspec}

\begin{ucspec}{UC-B06 — Liên kết định danh (tài khoản $\leftrightarrow$ cư dân $\leftrightarrow$ căn hộ)}
\ucrow{Mục đích}{Gắn tài khoản đăng nhập với hồ sơ cư dân và căn hộ để phân quyền/thông báo theo đối tượng.}
\ucrow{Tác nhân}{Quản trị viên / Ban quản lý.}
\ucrow{Tiền điều kiện}{Đã có tài khoản và danh mục căn hộ (cấu hình ở UC-B07).}
\ucrow{Luồng chính}{%
1.\ Chọn tài khoản cư dân và căn hộ tương ứng.\newline
2.\ Tạo liên kết định danh qua \texttt{Guid} cross-service (\texttt{unitId}) mà không nối khóa ngoại trực tiếp giữa các schema.\newline
3.\ Hệ thống dùng liên kết này để lọc dữ liệu và định tuyến thông báo theo cư dân/căn hộ.}
\ucrow{Luồng ngoại lệ}{E1.\ Căn hộ đã gắn cư dân khác $\rightarrow$ cảnh báo trước khi ghi đè.}
\ucrow{Hậu điều kiện}{Tài khoản gắn đúng cư dân/căn hộ, phục vụ tra cứu và gửi thông báo.}
\ucrow{Quy tắc nghiệp vụ}{Liên kết dùng định danh \texttt{Guid}, bảo đảm tách rời schema và cho phép phát triển song song.}
\end{ucspec}

\begin{ucspec}{UC-B07 — Gửi \& nhận thông báo}
\ucrow{Mục đích}{Soạn và phát thông báo tới nhóm đối tượng qua email và hộp thư trong hệ thống.}
\ucrow{Tác nhân}{Ban quản lý (gửi); mọi vai trò (nhận).}
\ucrow{Tiền điều kiện}{Đã đăng nhập; xác định được đối tượng nhận (theo vai trò/cư dân/căn hộ).}
\ucrow{Luồng chính}{%
1.\ Người gửi soạn tiêu đề/nội dung, chọn đối tượng nhận.\newline
2.\ Hệ thống phát vào hộp thư trong hệ thống theo \texttt{AuthUserId} và gửi email thật.\newline
3.\ Người nhận xem, đánh dấu đã đọc trong hộp thư.}
\ucrow{Luồng ngoại lệ}{E1.\ Đối tượng nhân sự rỗng $\rightarrow$ không phát, báo không có người nhận. E2.\ Gửi email thất bại $\rightarrow$ vẫn lưu hộp thư, ghi log lỗi.}
\ucrow{Hậu điều kiện}{Thông báo có trong hộp thư người nhận; lịch sử gửi được lưu.}
\ucrow{Quy tắc nghiệp vụ}{Kênh hỗ trợ gồm email và hộp thư trong hệ thống (chưa có SMS/Push).}
\end{ucspec}

\begin{ucspec}{UC-B08 — Tra cứu nhật ký kiểm toán (Audit log)}
\ucrow{Mục đích}{Xem lại vết thao tác trên toàn hệ thống phục vụ giám sát và điều tra.}
\ucrow{Tác nhân}{Quản trị viên.}
\ucrow{Tiền điều kiện}{Đã đăng nhập với quyền xem nhật ký.}
\ucrow{Luồng chính}{%
1.\ Mọi thao tác ghi/sửa đi qua action filter chung, tự động ghi bản ghi vào \texttt{auth.AuthAuditLog} (người thực hiện, hành động, thời điểm, dữ liệu).\newline
2.\ Quản trị viên lọc theo người dùng/hành động/khoảng thời gian và xem chi tiết.}
\ucrow{Luồng ngoại lệ}{E1.\ Yêu cầu bị chặn ở tầng \texttt{[ApiController]} (lỗi \texttt{400}) có thể không đi qua filter.}
\ucrow{Hậu điều kiện}{Nhật ký hiển thị theo bộ lọc; dữ liệu chỉ đọc.}
\ucrow{Quy tắc nghiệp vụ}{Ghi nhật ký tập trung qua một action filter toàn cục, không rải rác trong từng controller.}
\end{ucspec}

