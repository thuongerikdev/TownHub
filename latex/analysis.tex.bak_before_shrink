\end{longtable}}

Nhóm Bảo trì \& Sự cố được đặc tả bằng tám use case, tách theo hai dòng công việc hiện trường: xử lý sự cố theo SLA (UC-S01--S05) và bảo trì phòng ngừa theo Work Order (UC-S06--S08). Quan hệ include/extend giữa các use case như mô tả ở Hình 4.12.

\begin{ucspec}{UC-S01 — Báo sự cố}
\ucrow{Mục đích}{Ghi nhận sự cố do cư dân/đơn vị báo để đưa vào quy trình xử lý.}
\ucrow{Tác nhân}{Cư dân (\texttt{APP}); lễ tân/bảo vệ báo hộ (\texttt{RECEPTION}/\texttt{PHONE}).}
\ucrow{Tiền điều kiện}{Đã đăng nhập vai trò cư dân (hoặc người báo hộ).}
\ucrow{Luồng chính}{%
1.\ Nhập tiêu đề/mô tả/loại/ưu tiên/vị trí + ảnh.\newline
2.\ Gửi \texttt{POST /ticket/create}.\newline
3.\ Hệ thống sinh mã \texttt{TK-yyyyMM-\#\#\#\#}, tạo phiếu và lịch sử trạng thái \texttt{NEW}.}
\ucrow{Luồng ngoại lệ}{E1.\ Cư dân thử xem danh sách tài sản $\rightarrow$ chặn \texttt{403} (ngoài phạm vi).}
\ucrow{Hậu điều kiện}{Phiếu ở \texttt{NEW}, chờ phân công.}
\ucrow{Quy tắc nghiệp vụ}{Bước tạo phiếu chưa tính SLA/tự phân công (SLA bắt đầu sau khi phân công).}
\end{ucspec}

\begin{ucspec}{UC-S02 — Tiếp nhận \& phân công sự cố}
\ucrow{Mục đích}{Điều phối phiếu sự cố cho kỹ thuật viên phù hợp.}
\ucrow{Tác nhân}{Kỹ sư trưởng (kế thừa KTV) / Ban quản lý.}
\ucrow{Tiền điều kiện}{Có phiếu ở \texttt{NEW}.}
\ucrow{Luồng chính}{%
1.\ Xem phiếu \texttt{NEW}, chọn kỹ thuật viên.\newline
2.\ Phân công (\texttt{ticket\_assignments}); phiếu chuyển \texttt{ASSIGNED}; bắt đầu tính SLA.}
\ucrow{Luồng ngoại lệ}{E1.\ Kế toán/Cư dân thử phân công $\rightarrow$ chặn \texttt{403}.}
\ucrow{Hậu điều kiện}{Phiếu \texttt{ASSIGNED}, gắn kỹ thuật viên xử lý.}
\ucrow{Quy tắc nghiệp vụ}{Phân công là thao tác của người điều phối (không phải service tự chọn).}
\end{ucspec}

\begin{ucspec}{UC-S03 — Xử lý \& đóng ticket sự cố}
\ucrow{Mục đích}{Kỹ thuật viên xử lý sự cố và khép vòng đời phiếu.}
\ucrow{Tác nhân}{Kỹ thuật viên (xử lý); Kỹ sư trưởng (đóng ticket).}
\ucrow{Tiền điều kiện}{Phiếu ở \texttt{ASSIGNED}.}
\ucrow{Luồng chính}{%
1.\ KTV chuyển phiếu sang \texttt{IN\_PROGRESS} (kèm ghi \texttt{ticket\_status\_history}).\newline
2.\ (extend) Nếu cần vật tư: xuất kho hoặc tạo PR.\newline
3.\ Hoàn tất $\rightarrow$ \texttt{RESOLVED}.\newline
4.\ Kỹ sư trưởng đóng phiếu $\rightarrow$ \texttt{CLOSED}.}
\ucrow{Luồng ngoại lệ}{E1.\ Ban quản lý thử tự resolve $\rightarrow$ chặn \texttt{403} (chỉ điều phối, không xử lý kỹ thuật).}
\ucrow{Hậu điều kiện}{Phiếu \texttt{CLOSED} (xem trạng thái ở Hình 4.18).}
\ucrow{Quy tắc nghiệp vụ}{Chuyển trạng thái tuân thủ máy trạng thái ticket; mỗi bước ghi lịch sử.}
\end{ucspec}

\begin{ucspec}{UC-S04 — Đánh giá sự cố}
\ucrow{Mục đích}{Thu thập mức hài lòng của cư dân sau khi sự cố được xử lý.}
\ucrow{Tác nhân}{Cư dân (người báo).}
\ucrow{Tiền điều kiện}{Phiếu ở \texttt{RESOLVED}/\texttt{CLOSED}.}
\ucrow{Luồng chính}{%
1.\ Cư dân chấm điểm và nhận xét (\texttt{ticket\_ratings}).\newline
2.\ Điểm đánh giá đưa vào dashboard/thống kê chất lượng.}
\ucrow{Luồng ngoại lệ}{E1.\ Phiếu chưa xử lý xong $\rightarrow$ chưa cho đánh giá.}
\ucrow{Hậu điều kiện}{Đánh giá gắn với phiếu.}
\ucrow{Quy tắc nghiệp vụ}{Mỗi phiếu chỉ nhận một đánh giá của người báo.}
\end{ucspec}

\begin{ucspec}{UC-S05 — Cấu hình SLA \& leo thang}
\ucrow{Mục đích}{Thiết lập cam kết thời gian phản hồi/giải quyết và các mức leo thang.}
\ucrow{Tác nhân}{Ban quản lý.}
\ucrow{Tiền điều kiện}{Đã đăng nhập với quyền cấu hình SLA.}
\ucrow{Luồng chính}{%
1.\ Khai báo \texttt{sla\_configs} theo loại/ưu tiên (thời gian phản hồi, giải quyết).\newline
2.\ Thiết lập các mốc leo thang L1 $<$ L2 $<$ L3.\newline
3.\ Xem nhật ký leo thang (\texttt{sla\_escalation\_log}) và dashboard SLA.}
\ucrow{Luồng ngoại lệ}{E1.\ Nhập leo thang không tăng dần (L1$\ge$L2) hoặc phản hồi $\ge$ giải quyết $\rightarrow$ chặn khi lưu.}
\ucrow{Hậu điều kiện}{Cấu hình SLA có hiệu lực cho phiếu mới.}
\ucrow{Quy tắc nghiệp vụ}{Tự động phát hiện quá hạn (tác vụ nền) chưa hiện thực; theo dõi qua màn giám sát và nhật ký.}
\end{ucspec}

\begin{ucspec}{UC-S06 — Lập lịch bảo trì \& tạo/phân công Work Order}
\ucrow{Mục đích}{Lập lịch bảo trì phòng ngừa và sinh lệnh công việc giao cho KTV.}
\ucrow{Tác nhân}{Ban quản lý (lịch/cấu hình); Kỹ sư trưởng (tạo \& phân công WO).}
\ucrow{Tiền điều kiện}{Có tài sản và mẫu checklist (\texttt{checklist\_templates}).}
\ucrow{Luồng chính}{%
1.\ Khai báo \texttt{maintenance\_schedules} (chu kỳ, checklist).\newline
2.\ Kỹ sư trưởng xem lịch đến hạn, tạo Work Order (\texttt{DRAFT}).\newline
3.\ Phân công KTV (\texttt{work\_order\_assignments}); WO chuyển \texttt{ASSIGNED}.}
\ucrow{Luồng ngoại lệ}{E1.\ KTV/Kế toán thử tạo WO $\rightarrow$ chặn \texttt{403}.}
\ucrow{Hậu điều kiện}{WO \texttt{ASSIGNED} sẵn sàng để thực thi.}
\ucrow{Quy tắc nghiệp vụ}{WO được tạo thủ công từ danh sách lịch đến hạn (chưa có tác vụ nền tự sinh).}
\end{ucspec}

\begin{ucspec}{UC-S07 — Thực hiện Work Order}
\ucrow{Mục đích}{Kỹ thuật viên thực thi công việc bảo trì tại hiện trường và gửi nghiệm thu.}
\ucrow{Tác nhân}{Kỹ thuật viên được phân công.}
\ucrow{Tiền điều kiện}{WO ở \texttt{ASSIGNED}.}
\ucrow{Luồng chính}{%
1.\ Quét QR check-in $\rightarrow$ WO \texttt{IN\_PROGRESS}; tài sản $\rightarrow$ \texttt{MAINTENANCE}.\newline
2.\ (include) Điền checklist (\texttt{work\_order\_checklist\_responses}).\newline
3.\ (extend) Nếu cần: xuất kho \& ghi \texttt{work\_order\_materials\_used}.\newline
4.\ Đính ảnh minh chứng; gửi nghiệm thu $\rightarrow$ \texttt{PENDING\_REVIEW}.}
\ucrow{Luồng ngoại lệ}{E1.\ Chuyển trạng thái sai bị chặn (\texttt{WorkOrderState}). E2.\ Ban quản lý thử tự thực thi WO $\rightarrow$ chặn \texttt{403}.}
\ucrow{Hậu điều kiện}{WO ở \texttt{PENDING\_REVIEW}, chờ nghiệm thu.}
\ucrow{Quy tắc nghiệp vụ}{Check-in qua QR (UC-A03); trạng thái tài sản đồng bộ theo tiến độ WO.}
\end{ucspec}

\begin{ucspec}{UC-S08 — Nghiệm thu Work Order}
\ucrow{Mục đích}{Kiểm tra kết quả bảo trì và khép Work Order.}
\ucrow{Tác nhân}{Kỹ sư trưởng.}
\ucrow{Tiền điều kiện}{WO ở \texttt{PENDING\_REVIEW}.}
\ucrow{Luồng chính}{%
1.\ Xem checklist, ảnh minh chứng và vật tư đã dùng.\newline
2.\ Nghiệm thu đạt $\rightarrow$ \texttt{COMPLETED}; tài sản trở lại \texttt{ACTIVE}.}
\ucrow{Luồng ngoại lệ}{A1.\ Không đạt $\rightarrow$ \texttt{REJECTED}, trả về cho KTV làm lại.}
\ucrow{Hậu điều kiện}{WO \texttt{COMPLETED} hoặc \texttt{REJECTED} (Hình 4.14).}
\ucrow{Quy tắc nghiệp vụ}{Chỉ khi \texttt{COMPLETED} tài sản mới thoát trạng thái \texttt{MAINTENANCE}.}
\end{ucspec}

