Nhóm Vòng đời tài sản được đặc tả bằng bảy use case, trải suốt vòng đời từ khai báo danh mục, ghi tăng, sinh QR, điều chuyển, khấu hao định kỳ, đến thanh lý và tra cứu sổ sách — mọi biến động đều gắn với chứng từ kế toán định khoản Nợ/Có.

\begin{ucspec}{UC-A01 — Quản lý danh mục loại \& vị trí tài sản}
\ucrow{Mục đích}{Khai báo loại tài sản và vị trí (toà/tầng/khu) làm nền cho ghi tăng và tra cứu.}
\ucrow{Tác nhân}{Kỹ sư trưởng.}
\ucrow{Tiền điều kiện}{Đã đăng nhập với quyền quản lý tài sản.}
\ucrow{Luồng chính}{%
1.\ Tạo/sửa \texttt{asset\_categories} (kèm khung tỉ lệ/thời gian khấu hao mặc định).\newline
2.\ Tạo/sửa \texttt{asset\_locations} theo cấu trúc toà/tầng.}
\ucrow{Luồng ngoại lệ}{E1.\ Xoá loại/vị trí đang gắn tài sản $\rightarrow$ chặn hoặc yêu cầu chuyển trước.}
\ucrow{Hậu điều kiện}{Danh mục loại/vị trí sẵn sàng cho nghiệp vụ ghi tăng.}
\ucrow{Quy tắc nghiệp vụ}{Loại tài sản gợi ý phương pháp/kỳ khấu hao mặc định khi ghi tăng.}
\end{ucspec}

\begin{ucspec}{UC-A02 — Ghi tăng tài sản}
\ucrow{Mục đích}{Đưa tài sản mới vào theo dõi kèm chứng từ ghi tăng.}
\ucrow{Tác nhân}{Kế toán / Kỹ sư trưởng.}
\ucrow{Tiền điều kiện}{Có tài sản mới (mua/tiếp nhận), biết nguyên giá.}
\ucrow{Luồng chính}{%
1.\ Nhập thông tin tài sản, nguyên giá, tài khoản (211/213), phương thức thanh toán (111/112).\newline
2.\ Hệ thống sinh \texttt{assetCode}, tạo tài sản trạng thái \texttt{ACTIVE} (giá trị còn lại = nguyên giá).\newline
3.\ Tự dựng chứng từ \texttt{GHI\_TANG} với định khoản Nợ 211/213 -- Có 111/112 trong cùng giao dịch.}
\ucrow{Luồng ngoại lệ}{E1.\ Nguyên giá $\le 0$ hoặc thiếu tài khoản $\rightarrow$ chặn. E2.\ Ngày mua ở tương lai/hạn bảo hành trước ngày mua $\rightarrow$ chặn.}
\ucrow{Hậu điều kiện}{Tài sản \texttt{ACTIVE}; chứng từ ghi tăng đã ghi sổ.}
\ucrow{Quy tắc nghiệp vụ}{Ghi tăng và định khoản là nguyên tử (cùng transaction); mã tài sản do máy chủ sinh.}
\end{ucspec}

\begin{ucspec}{UC-A03 — Sinh \& in mã QR tài sản}
\ucrow{Mục đích}{Gắn mã QR cho tài sản phục vụ check-in bảo trì và kiểm kê.}
\ucrow{Tác nhân}{Kỹ sư trưởng.}
\ucrow{Tiền điều kiện}{Tài sản đã tồn tại.}
\ucrow{Luồng chính}{%
1.\ Sinh mã QR gắn \texttt{assetCode} (\texttt{asset\_qr\_codes}).\newline
2.\ In tem QR để dán lên tài sản.\newline
3.\ Khi quét, hệ thống điều hướng tới hồ sơ tài sản.}
\ucrow{Luồng ngoại lệ}{E1.\ Tài sản đã có QR còn hiệu lực $\rightarrow$ dùng lại, không sinh trùng.}
\ucrow{Hậu điều kiện}{Tài sản có mã QR tra cứu được.}
\ucrow{Quy tắc nghiệp vụ}{QR liên kết trực tiếp check-in Work Order (UC-S07).}
\end{ucspec}

\begin{ucspec}{UC-A04 — Điều chuyển tài sản}
\ucrow{Mục đích}{Ghi nhận thay đổi vị trí/bộ phận sử dụng của tài sản.}
\ucrow{Tác nhân}{Kỹ sư trưởng.}
\ucrow{Tiền điều kiện}{Tài sản ở trạng thái \texttt{ACTIVE}.}
\ucrow{Luồng chính}{%
1.\ Chọn tài sản, vị trí đích và lý do điều chuyển.\newline
2.\ Ghi \texttt{asset\_transfers} (có thể gắn Work Order); cập nhật vị trí hiện tại của tài sản.}
\ucrow{Luồng ngoại lệ}{E1.\ Tài sản đang \texttt{MAINTENANCE}/\texttt{DISPOSED} $\rightarrow$ chặn điều chuyển.}
\ucrow{Hậu điều kiện}{Vị trí tài sản được cập nhật; lịch sử điều chuyển lưu vết.}
\ucrow{Quy tắc nghiệp vụ}{Điều chuyển không đổi nguyên giá/giá trị còn lại, chỉ đổi vị trí quản lý.}
\end{ucspec}

\begin{ucspec}{UC-A05 — Khấu hao định kỳ}
\ucrow{Mục đích}{Tính và ghi nhận chi phí khấu hao theo kỳ, cập nhật giá trị còn lại.}
\ucrow{Tác nhân}{Kế toán / Ban quản lý.}
\ucrow{Tiền điều kiện}{Tài sản \texttt{ACTIVE} còn giá trị khấu hao.}
\ucrow{Luồng chính}{%
1.\ Người dùng chạy khấu hao theo kỳ (run-period).\newline
2.\ Với mỗi tài sản, tính mức khấu hao (đường thẳng hoặc số dư giảm dần).\newline
3.\ Tạo chứng từ \texttt{KHAU\_HAO} (Nợ 642 -- Có 2141/2143), cập nhật hao mòn luỹ kế \& giá trị còn lại, ghi \texttt{asset\_depreciation\_log}.}
\ucrow{Luồng ngoại lệ}{E1.\ Kỳ đã chạy khấu hao $\rightarrow$ không tính trùng. E2.\ Giá trị còn lại về 0 $\rightarrow$ dừng khấu hao.}
\ucrow{Hậu điều kiện}{Giá trị còn lại giảm; nhật ký khấu hao kỳ được lưu.}
\ucrow{Quy tắc nghiệp vụ}{Khấu hao chạy theo kỳ khi người dùng gọi (chưa có tác vụ nền tự chạy hằng tháng).}
\end{ucspec}

\begin{ucspec}{UC-A06 — Thanh lý tài sản}
\ucrow{Mục đích}{Ghi giảm tài sản khi thanh lý và hạch toán lãi/lỗ.}
\ucrow{Tác nhân}{Kế toán.}
\ucrow{Tiền điều kiện}{Tài sản \texttt{ACTIVE}; đã có quyết định thanh lý.}
\ucrow{Luồng chính}{%
1.\ Chọn tài sản, nhập giá trị thu hồi.\newline
2.\ Hệ thống dựng chứng từ \texttt{THANH\_LY} (giá trị còn lại 811, thu hồi 111/112), tính lãi/lỗ, ghi \texttt{asset\_disposal}.\newline
3.\ Chuyển trạng thái tài sản $\rightarrow$ \texttt{DISPOSED}.}
\ucrow{Luồng ngoại lệ}{E1.\ Giá trị thu hồi âm $\rightarrow$ chặn. E2.\ Tài sản đang \texttt{MAINTENANCE} $\rightarrow$ yêu cầu hoàn tất WO trước.}
\ucrow{Hậu điều kiện}{Tài sản \texttt{DISPOSED}; chứng từ thanh lý và lãi/lỗ đã ghi sổ.}
\ucrow{Quy tắc nghiệp vụ}{\texttt{DISPOSED} là trạng thái cuối, không đảo ngược (Hình 4.10).}
\end{ucspec}

\begin{ucspec}{UC-A07 — Tra cứu sổ sách \& báo cáo tài sản}
\ucrow{Mục đích}{Xem chứng từ, bảng cân đối tài sản và báo cáo phục vụ kế toán.}
\ucrow{Tác nhân}{Kế toán / Ban quản lý.}
\ucrow{Tiền điều kiện}{Đã đăng nhập với quyền xem báo cáo tài sản.}
\ucrow{Luồng chính}{%
1.\ Lọc theo loại/vị trí/kỳ.\newline
2.\ Xem danh sách tài sản, nhật ký khấu hao và chứng từ (\texttt{asset\_document}/\texttt{asset\_document\_line}).\newline
3.\ Kết xuất báo cáo/bảng cân đối thử.}
\ucrow{Luồng ngoại lệ}{E1.\ Không có quyền $\rightarrow$ chặn \texttt{403} (ví dụ Kỹ thuật viên).}
\ucrow{Hậu điều kiện}{Số liệu hiển thị theo bộ lọc; dữ liệu chỉ đọc.}
\ucrow{Quy tắc nghiệp vụ}{Kế toán được xem/cập nhật nhưng không được tạo mới tài sản (theo ma trận phân quyền).}
\end{ucspec}

