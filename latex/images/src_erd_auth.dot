digraph ERD {
rankdir=LR; splines=true; nodesep=0.5; ranksep=1.0;
node [shape=plaintext, fontname="Arial", fontsize=11];
edge [color="#666666", arrowsize=0.8, penwidth=1.0];
AuthUser [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>AuthUser</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK userID</td></tr><tr><td align="left" balign="left">userName (unique), email</td></tr><tr><td align="left" balign="left">passwordHash, googleSub</td></tr><tr><td align="left" balign="left">scope (staff|user), status</td></tr><tr><td align="left" balign="left">isEmailVerified, tokenVersion</td></tr></table>>];
AuthProfile [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>AuthProfile</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK profileID</td></tr><tr><td align="left" balign="left">FK userID (1-1)</td></tr><tr><td align="left" balign="left">firstName, lastName</td></tr><tr><td align="left" balign="left">avatar, gender, dateOfBirth</td></tr></table>>];
AuthRole [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>AuthRole</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK roleID</td></tr><tr><td align="left" balign="left">roleName (unique)</td></tr><tr><td align="left" balign="left">roleDescription</td></tr><tr><td align="left" balign="left">isDefault, scope</td></tr></table>>];
AuthPermission [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>AuthPermission</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK permissionID</td></tr><tr><td align="left" balign="left">permissionName</td></tr><tr><td align="left" balign="left">code (claim 'permission')</td></tr></table>>];
AuthUserRole [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>AuthUserRole</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK (userID, roleID)</td></tr><tr><td align="left" balign="left">FK userID, FK roleID</td></tr><tr><td align="left" balign="left">assignedAt</td></tr></table>>];
AuthRolePermission [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>AuthRolePermission</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK rolePermissionID</td></tr><tr><td align="left" balign="left">FK roleID, FK permissionID</td></tr></table>>];
AuthUserSession [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>AuthUserSession</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK sessionID</td></tr><tr><td align="left" balign="left">FK userID</td></tr><tr><td align="left" balign="left">deviceId, ip, userAgent</td></tr><tr><td align="left" balign="left">createdAt, lastSeenAt, isRevoked</td></tr></table>>];
AuthRefreshToken [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>AuthRefreshToken</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK refreshTokenID</td></tr><tr><td align="left" balign="left">FK userID, FK sessionID</td></tr><tr><td align="left" balign="left">token (base64), expires</td></tr><tr><td align="left" balign="left">replacedByToken (xoay vòng)</td></tr></table>>];
AuthMfaSecret [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>AuthMfaSecret</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK mfaID</td></tr><tr><td align="left" balign="left">FK userID (1-1)</td></tr><tr><td align="left" balign="left">type (TOTP), status</td></tr><tr><td align="left" balign="left">secret (Base32)</td></tr></table>>];
AuthEmailVerification [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>AuthEmailVerification</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK emailVerificationID</td></tr><tr><td align="left" balign="left">FK userID</td></tr><tr><td align="left" balign="left">codeHash, expiresAt, consumedAt</td></tr></table>>];
AuthPasswordReset [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>AuthPasswordReset</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK passwordResetID</td></tr><tr><td align="left" balign="left">FK userID</td></tr><tr><td align="left" balign="left">codeHash, purpose</td></tr><tr><td align="left" balign="left">expiresAt, consumedAt</td></tr></table>>];
AuthAuditLog [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>AuthAuditLog</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK auditID</td></tr><tr><td align="left" balign="left">FK userID (nullable)</td></tr><tr><td align="left" balign="left">action, result, detail</td></tr><tr><td align="left" balign="left">ip, userAgent, createdAt</td></tr></table>>];
AuthProfile -> AuthUser;
AuthUserRole -> AuthUser;
AuthUserRole -> AuthRole;
AuthRolePermission -> AuthRole;
AuthRolePermission -> AuthPermission;
AuthUserSession -> AuthUser;
AuthRefreshToken -> AuthUser;
AuthRefreshToken -> AuthUserSession;
AuthMfaSecret -> AuthUser;
AuthEmailVerification -> AuthUser;
AuthPasswordReset -> AuthUser;
AuthAuditLog -> AuthUser;
}