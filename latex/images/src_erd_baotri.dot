digraph ERD {
rankdir=LR; splines=true; nodesep=0.45; ranksep=0.9;
node [shape=plaintext, fontname="Arial", fontsize=11];
edge [color="#666666", arrowsize=0.8, penwidth=1.0];
checklist_templates [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>checklist_templates</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">code, name</td></tr><tr><td align="left" balign="left">FK categoryId</td></tr></table>>];
checklist_template_items [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>checklist_template_items</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK templateId</td></tr><tr><td align="left" balign="left">itemType, itemLabel</td></tr><tr><td align="left" balign="left">isRequired, sortOrder</td></tr></table>>];
maintenance_schedules [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>maintenance_schedules</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK assetId</td></tr><tr><td align="left" balign="left">FK checklistTemplateId</td></tr><tr><td align="left" balign="left">frequencyType, nextDueDate</td></tr><tr><td align="left" balign="left">isActive, leadTimeDays</td></tr></table>>];
work_orders [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>work_orders</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">woCode, woType (PM|CM)</td></tr><tr><td align="left" balign="left">FK assetId, scheduleId</td></tr><tr><td align="left" balign="left">FK checklistTemplateId</td></tr><tr><td align="left" balign="left">status, priority</td></tr><tr><td align="left" balign="left">assignedToUserId</td></tr><tr><td align="left" balign="left">scheduledDate, dueDate</td></tr><tr><td align="left" balign="left">actualHours, totalCost</td></tr></table>>];
work_order_assignments [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>work_order_assignments</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK woId</td></tr><tr><td align="left" balign="left">assignedTo(+UserId)</td></tr><tr><td align="left" balign="left">FK checkinQrAssetId</td></tr><tr><td align="left" balign="left">assignedAt</td></tr></table>>];
work_order_checklist_responses [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>work_order_checklist_responses</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK woId</td></tr><tr><td align="left" balign="left">FK templateItemId</td></tr><tr><td align="left" balign="left">isPassed, valueText</td></tr><tr><td align="left" balign="left">photoUrl</td></tr></table>>];
work_order_attachments [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>work_order_attachments</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK woId</td></tr><tr><td align="left" balign="left">attachmentType, fileUrl</td></tr></table>>];
work_order_materials_used [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>work_order_materials_used</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK woId</td></tr><tr><td align="left" balign="left">FK materialId, warehouseId</td></tr><tr><td align="left" balign="left">FK inventoryTransactionId</td></tr></table>>];
sla_configs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>sla_configs</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">name, buildingId</td></tr><tr><td align="left" balign="left">issueCategory, priorityLevel</td></tr><tr><td align="left" balign="left">responseTimeHours</td></tr><tr><td align="left" balign="left">resolutionTimeHours</td></tr><tr><td align="left" balign="left">escalationL1/L2/L3AfterHours</td></tr><tr><td align="left" balign="left">escalationContactsJson</td></tr></table>>];
tickets [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>tickets</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">ticketCode, status</td></tr><tr><td align="left" balign="left">buildingId, assetId</td></tr><tr><td align="left" balign="left">reportedBy(+Name)</td></tr><tr><td align="left" balign="left">assignedToUserId</td></tr><tr><td align="left" balign="left">FK slaConfigId</td></tr><tr><td align="left" balign="left">FK purchaseRequestId</td></tr><tr><td align="left" balign="left">category, priority, source</td></tr><tr><td align="left" balign="left">resolvedAt, closedAt, autoClosed</td></tr></table>>];
ticket_assignments [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>ticket_assignments</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK ticketId</td></tr><tr><td align="left" balign="left">assignedTo(+UserId)</td></tr><tr><td align="left" balign="left">assignedAt</td></tr></table>>];
ticket_attachments [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>ticket_attachments</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK ticketId</td></tr><tr><td align="left" balign="left">fileUrl</td></tr></table>>];
ticket_ratings [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>ticket_ratings</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK ticketId</td></tr><tr><td align="left" balign="left">ratedBy</td></tr><tr><td align="left" balign="left">overallRating</td></tr></table>>];
ticket_status_history [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>ticket_status_history</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK ticketId</td></tr><tr><td align="left" balign="left">fromStatus, toStatus</td></tr><tr><td align="left" balign="left">changedBy, changedAt</td></tr><tr><td align="left" balign="left">note</td></tr></table>>];
sla_escalation_log [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>sla_escalation_log</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK ticketId</td></tr><tr><td align="left" balign="left">escalationLevel</td></tr><tr><td align="left" balign="left">escalatedTo, channel</td></tr><tr><td align="left" balign="left">escalatedAt, acknowledgedAt</td></tr></table>>];
assets [shape=box, style="dashed,rounded", color="#9aa7bd", fontcolor="#5a6b86", fontname="Arial", fontsize=10, label="assets\n(Vòng đời tài sản)"];
materials [shape=box, style="dashed,rounded", color="#9aa7bd", fontcolor="#5a6b86", fontname="Arial", fontsize=10, label="materials\n(Mua sắm / Kho)"];
warehouses [shape=box, style="dashed,rounded", color="#9aa7bd", fontcolor="#5a6b86", fontname="Arial", fontsize=10, label="warehouses\n(Mua sắm / Kho)"];
purchase_requests [shape=box, style="dashed,rounded", color="#9aa7bd", fontcolor="#5a6b86", fontname="Arial", fontsize=10, label="purchase_requests\n(Mua sắm)"];
checklist_template_items -> checklist_templates;
maintenance_schedules -> checklist_templates;
work_orders -> maintenance_schedules;
work_orders -> checklist_templates;
work_order_assignments -> work_orders;
work_order_checklist_responses -> work_orders;
work_order_checklist_responses -> checklist_template_items;
work_order_attachments -> work_orders;
work_order_materials_used -> work_orders;
tickets -> sla_configs;
ticket_assignments -> tickets;
ticket_attachments -> tickets;
ticket_ratings -> tickets;
ticket_status_history -> tickets;
sla_escalation_log -> tickets;
maintenance_schedules -> assets [style=dashed, color="#9aa7bd", arrowsize=0.7];
work_orders -> assets [style=dashed, color="#9aa7bd", arrowsize=0.7];
tickets -> assets [style=dashed, color="#9aa7bd", arrowsize=0.7];
work_order_materials_used -> materials [style=dashed, color="#9aa7bd", arrowsize=0.7];
work_order_materials_used -> warehouses [style=dashed, color="#9aa7bd", arrowsize=0.7];
tickets -> purchase_requests [style=dashed, color="#9aa7bd", arrowsize=0.7];
}