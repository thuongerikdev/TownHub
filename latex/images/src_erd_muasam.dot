digraph ERD {
rankdir=LR; splines=true; nodesep=0.45; ranksep=0.9;
node [shape=plaintext, fontname="Arial", fontsize=11];
edge [color="#666666", arrowsize=0.8, penwidth=1.0];
warehouses [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>warehouses</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">code, name</td></tr><tr><td align="left" balign="left">buildingId, managerId</td></tr></table>>];
material_categories [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>material_categories</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">code, name</td></tr><tr><td align="left" balign="left">FK parentId</td></tr></table>>];
materials [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>materials</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">materialCode, name</td></tr><tr><td align="left" balign="left">FK categoryId</td></tr><tr><td align="left" balign="left">FK preferredVendorId</td></tr><tr><td align="left" balign="left">minStock, reorderPoint, unitPrice</td></tr></table>>];
inventory_levels [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>inventory_levels</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK warehouseId, materialId</td></tr><tr><td align="left" balign="left">quantityOnHand</td></tr></table>>];
inventory_transactions [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>inventory_transactions</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">txnCode, txnType (IN|OUT|ADJUST|TRANSFER)</td></tr><tr><td align="left" balign="left">FK warehouseId, materialId</td></tr><tr><td align="left" balign="left">referenceType, referenceId</td></tr><tr><td align="left" balign="left">quantity, unitCost, performedBy</td></tr></table>>];
purchase_requests [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>purchase_requests</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">prCode, status (DRAFT→SUBMITTED→APPROVED/REJECTED)</td></tr><tr><td align="left" balign="left">FK ticketId, woId</td></tr><tr><td align="left" balign="left">requestedBy(+UserId), priority</td></tr><tr><td align="left" balign="left">approvedBy, neededByDate</td></tr></table>>];
purchase_request_items [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>purchase_request_items</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK prId, materialId</td></tr><tr><td align="left" balign="left">FK targetWarehouseId</td></tr></table>>];
purchase_orders [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>purchase_orders</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">poCode, status</td></tr><tr><td align="left" balign="left">FK prId, vendorId</td></tr><tr><td align="left" balign="left">issueDate, totalAmount, currency</td></tr></table>>];
purchase_order_items [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>purchase_order_items</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK poId, materialId</td></tr><tr><td align="left" balign="left">FK targetWarehouseId</td></tr></table>>];
po_approval_workflow [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>po_approval_workflow</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK poId</td></tr><tr><td align="left" balign="left">approverId, approvalLevel</td></tr><tr><td align="left" balign="left">status (PENDING→APPROVED/REJECTED)</td></tr></table>>];
invoices [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>invoices</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">invoiceCode, status</td></tr><tr><td align="left" balign="left">paymentStatus (UNPAID→PAID)</td></tr><tr><td align="left" balign="left">FK vendorId, poId, ocrJobId</td></tr><tr><td align="left" balign="left">totalAmount, confirmedBy</td></tr></table>>];
invoice_items [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>invoice_items</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK invoiceId, materialId</td></tr><tr><td align="left" balign="left">FK poItemId</td></tr><tr><td align="left" balign="left">quantity, unitPrice, totalPrice</td></tr></table>>];
ocr_jobs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>ocr_jobs</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">documentType, status (QUEUED→PROCESSING→COMPLETED/FAILED→REVIEWED)</td></tr><tr><td align="left" balign="left">ocrEngine (paddleocr|vietocr)</td></tr><tr><td align="left" balign="left">rawExtractedText, confidenceScore</td></tr><tr><td align="left" balign="left">submittedBy, reviewedBy</td></tr></table>>];
stock_takes [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>stock_takes</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">stkCode, period, status</td></tr><tr><td align="left" balign="left">FK warehouseId</td></tr><tr><td align="left" balign="left">totalItems, diffItems, totalDiffValue</td></tr></table>>];
stock_take_lines [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>stock_take_lines</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK stockTakeId, materialId</td></tr><tr><td align="left" balign="left">systemQty, countedQty, diff</td></tr><tr><td align="left" balign="left">diffValue</td></tr></table>>];
vendors [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>vendors</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">vendorCode, name, taxId</td></tr><tr><td align="left" balign="left">status (ACTIVE/blacklist)</td></tr><tr><td align="left" balign="left">contactName/Email/Phone</td></tr></table>>];
vendor_contracts [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>vendor_contracts</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">contractCode</td></tr><tr><td align="left" balign="left">FK vendorId</td></tr><tr><td align="left" balign="left">startDate, endDate, contractValue</td></tr><tr><td align="left" balign="left">status, renewalNoticeDays</td></tr></table>>];
vendor_contract_services [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>vendor_contract_services</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK contractId</td></tr><tr><td align="left" balign="left">serviceName</td></tr></table>>];
vendor_evaluations [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0"><tr><td bgcolor="#C9D4EC"><b>vendor_evaluations</b></td></tr><tr><td><font point-size="1"> </font></td></tr><tr><td align="left" balign="left">PK id</td></tr><tr><td align="left" balign="left">FK vendorId, contractId</td></tr><tr><td align="left" balign="left">evaluatorId</td></tr><tr><td align="left" balign="left">overall/quality/timeliness/cost/safety Score</td></tr></table>>];
tickets [shape=box, style="dashed,rounded", color="#9aa7bd", fontcolor="#5a6b86", fontname="Arial", fontsize=10, label="tickets\n(Sự cố)"];
work_orders [shape=box, style="dashed,rounded", color="#9aa7bd", fontcolor="#5a6b86", fontname="Arial", fontsize=10, label="work_orders\n(Bảo trì)"];
materials -> material_categories;
materials -> vendors;
inventory_levels -> warehouses;
inventory_levels -> materials;
inventory_transactions -> warehouses;
inventory_transactions -> materials;
purchase_request_items -> purchase_requests;
purchase_request_items -> materials;
purchase_request_items -> warehouses;
purchase_orders -> purchase_requests;
purchase_orders -> vendors;
purchase_order_items -> purchase_orders;
purchase_order_items -> materials;
purchase_order_items -> warehouses;
po_approval_workflow -> purchase_orders;
invoices -> vendors;
invoices -> purchase_orders;
invoices -> ocr_jobs;
invoice_items -> invoices;
invoice_items -> materials;
invoice_items -> purchase_order_items;
stock_takes -> warehouses;
stock_take_lines -> stock_takes;
stock_take_lines -> materials;
vendor_contracts -> vendors;
vendor_contract_services -> vendor_contracts;
vendor_evaluations -> vendors;
vendor_evaluations -> vendor_contracts;
purchase_requests -> tickets [style=dashed, color="#9aa7bd", arrowsize=0.7];
purchase_requests -> work_orders [style=dashed, color="#9aa7bd", arrowsize=0.7];
}