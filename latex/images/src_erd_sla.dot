// ERD Phân hệ Quản lý sự cố & SLA — style Graphviz giống erd_asset.pdf
// Render:  dot -Tpdf src_erd_sla.dot -o img39.pdf
digraph sla {
  graph [rankdir=LR, splines=true, nodesep=0.5, ranksep=1.0, bgcolor="white",
         label=<<b>ERD — Phân hệ Quản lý sự cố &amp; SLA</b><br/><font point-size="10" color="#666666">Nút viền đứt (assets, purchase_requests): bảng liên kết, chi tiết ở Hình 4.5 / 4.12.</font>>,
         labelloc=t, fontname="Arial", fontsize=15];
  node  [shape=plaintext, fontname="Arial", fontsize=10];
  edge  [color="#666666", arrowsize=0.7, penwidth=1.0];

  tickets [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0">
      <tr><td bgcolor="#C9D4EC"><b>tickets</b></td></tr><hr/>
      <tr><td align="left" balign="left">PK id<br/>ticketCode<br/>status<br/>buildingId, floorId, unitId<br/>FK assetId<br/>reportedBy, reportedByName<br/>assignedToUserId, assignedToName<br/>FK slaConfigId<br/>FK purchaseRequestId<br/>category, priority, source<br/>resolvedAt, closedAt</td></tr></table>>];
  sla_configs [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0">
      <tr><td bgcolor="#C9D4EC"><b>sla_configs</b></td></tr><hr/>
      <tr><td align="left" balign="left">PK id<br/>name<br/>buildingId<br/>issueCategory<br/>priorityLevel<br/>responseTimeHours<br/>resolutionTimeHours<br/>escalationL1/L2/L3AfterHours<br/>businessHoursOnly, isActive</td></tr></table>>];
  ticket_assignments [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0">
      <tr><td bgcolor="#C9D4EC"><b>ticket_assignments</b></td></tr><hr/>
      <tr><td align="left" balign="left">PK id<br/>FK ticketId<br/>assignedTo<br/>assignedToUserId, assignedToName<br/>assignedAt</td></tr></table>>];
  ticket_attachments [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0">
      <tr><td bgcolor="#C9D4EC"><b>ticket_attachments</b></td></tr><hr/>
      <tr><td align="left" balign="left">PK id<br/>FK ticketId<br/>fileUrl</td></tr></table>>];
  ticket_ratings [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0">
      <tr><td bgcolor="#C9D4EC"><b>ticket_ratings</b></td></tr><hr/>
      <tr><td align="left" balign="left">PK id<br/>FK ticketId<br/>ratedBy<br/>overallRating</td></tr></table>>];
  ticket_status_history [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0">
      <tr><td bgcolor="#C9D4EC"><b>ticket_status_history</b></td></tr><hr/>
      <tr><td align="left" balign="left">PK id<br/>FK ticketId<br/>fromStatus, toStatus<br/>changedBy<br/>changedAt, note</td></tr></table>>];
  sla_escalation_log [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#8FA8D0">
      <tr><td bgcolor="#C9D4EC"><b>sla_escalation_log</b></td></tr><hr/>
      <tr><td align="left" balign="left">PK id<br/>FK ticketId<br/>escalationLevel<br/>escalatedAt, escalatedTo<br/>channel, message<br/>acknowledgedAt, acknowledgedBy</td></tr></table>>];

  // Bảng liên kết (thuộc ERD khác) — viền đứt, header xám
  assets [style=dashed, label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#AAAAAA">
      <tr><td bgcolor="#E4E4E4"><b>assets</b></td></tr><hr/>
      <tr><td align="left" balign="left"><i>(chi tiết ở Hình 4.5)</i><br/>PK id</td></tr></table>>];
  purchase_requests [style=dashed, label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#AAAAAA">
      <tr><td bgcolor="#E4E4E4"><b>purchase_requests</b></td></tr><hr/>
      <tr><td align="left" balign="left"><i>(chi tiết ở Hình 4.12)</i><br/>PK id</td></tr></table>>];

  // Quan hệ: con (giữ FK) -> cha (được tham chiếu)
  ticket_assignments -> tickets;
  ticket_attachments -> tickets;
  ticket_ratings -> tickets;
  sla_escalation_log -> tickets;
  ticket_status_history -> tickets;
  tickets -> sla_configs;
  tickets -> assets [style=dashed];
  tickets -> purchase_requests [style=dashed];
}
