        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam usecase {\n    BackgroundColor White\n    BorderColor Black\n}\nskinparam actor {\n    BackgroundColor White\n    BorderColor Black\n}\n\nactor \&quot;Kỹ sư trưởng\&quot; as KST\nactor \&quot;Ban quản lý\&quot; as BQL\nactor \&quot;Kế toán\&quot; as KT\n\nBQL --|&gt; KST\n\npackage \&quot;8. Báo cáo &amp; BI\&quot; {\n    usecase \&quot;UC56: Xem Dashboard vận hành\&quot; as UC56\n    usecase \&quot;UC57: Xem KPI MTTR/MTBF\&quot; as UC57\n    usecase \&quot;UC58: Xem Cost Tracking\&quot; as UC58\n    usecase \&quot;UC59: Xuất báo cáo PDF/Excel\&quot; as UC59\n    usecase \&quot;UC60: Xem KPI theo tài sản\&quot; as UC60\n    \n    usecase \&quot;UC61: Theo dõi ngân sách bảo trì\&quot; as UC61\n}\n\nKST --&gt; UC56\nKST --&gt; UC57\nKST --&gt; UC58\nKST --&gt; UC59\nKST --&gt; UC60\n\nBQL --&gt; UC61\n\nKT --&gt; UC58\nKT --&gt; UC59\nKT --&gt; UC61\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="Jsn1NDj1NjuvTaq5IqC4-9">
