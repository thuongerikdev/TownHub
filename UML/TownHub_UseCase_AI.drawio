        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam usecase {\n    BackgroundColor White\n    BorderColor Black\n}\nskinparam actor {\n    BackgroundColor White\n    BorderColor Black\n}\n\nactor \&quot;Hệ thống / IoT\&quot; as SYS\n\npackage \&quot;9. Hệ thống tự động\&quot; {\n    usecase \&quot;UC62: Kiểm tra lịch PM tự động\&quot; as UC62\n    usecase \&quot;UC63: Gửi thông báo đa kênh\&quot; as UC63\n    usecase \&quot;UC64: Leo thang SLA tự động\&quot; as UC64\n    usecase \&quot;UC65: Tự động đóng Ticket 24h\&quot; as UC65\n    usecase \&quot;UC66: Tính khấu hao tháng\&quot; as UC66\n    usecase \&quot;UC67: Snapshot KPI hàng ngày\&quot; as UC67\n    usecase \&quot;UC68: Đọc &amp; xử lý dữ liệu IoT\&quot; as UC68\n}\n\nSYS --&gt; UC62\nSYS --&gt; UC63\nSYS --&gt; UC64\nSYS --&gt; UC65\nSYS --&gt; UC66\nSYS --&gt; UC67\nSYS --&gt; UC68\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="Jsn1NDj1NjuvTaq5IqC4-10">
