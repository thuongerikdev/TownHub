        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam usecase {\n    BackgroundColor White\n    BorderColor Black\n}\nskinparam actor {\n    BackgroundColor White\n    BorderColor Black\n}\n\nactor \&quot;Bảo vệ\&quot; as BV\nactor \&quot;Cư dân\&quot; as CD\nactor \&quot;Kỹ thuật viên\&quot; as KTV\nactor \&quot;Kỹ sư trưởng\&quot; as KST\nactor \&quot;Ban quản lý\&quot; as BQL\n\nCD --|&gt; BV\nKST --|&gt; KTV\nBQL --|&gt; KST\n\npackage \&quot;7. Xử lý sự cố (CM)\&quot; {\n    usecase \&quot;UC47: Báo sự cố\&quot; as UC47\n    usecase \&quot;UC48: Theo dõi Ticket\&quot; as UC48\n    usecase \&quot;UC49: Đánh giá chất lượng xử lý\&quot; as UC49\n    \n    usecase \&quot;UC50: Xem danh sách Ticket\&quot; as UC50\n    usecase \&quot;UC52: Khảo sát &amp; xác nhận vật tư\&quot; as UC52\n    usecase \&quot;UC53: Đóng Ticket\&quot; as UC53\n    \n    usecase \&quot;UC51: Phân công KTV xử lý\&quot; as UC51\n    usecase \&quot;UC54: Xem SLA Dashboard\&quot; as UC54\n    usecase \&quot;UC55: Cấu hình SLA\&quot; as UC55\n}\n\nBV --&gt; UC47\nBV --&gt; UC48\nCD --&gt; UC49\n\nKTV --&gt; UC50\nKTV --&gt; UC52\nKTV --&gt; UC53\n\nKST --&gt; UC51\nKST --&gt; UC54\n\nBQL --&gt; UC47\nBQL --&gt; UC55\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="Jsn1NDj1NjuvTaq5IqC4-8">
