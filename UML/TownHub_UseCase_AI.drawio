        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam usecase {\n    BackgroundColor White\n    BorderColor Black\n}\nskinparam actor {\n    BackgroundColor White\n    BorderColor Black\n}\n\nactor \&quot;Kỹ thuật viên\&quot; as KTV\nactor \&quot;Kỹ sư trưởng\&quot; as KST\nactor \&quot;Ban quản lý\&quot; as BQL\nactor \&quot;Hệ thống / IoT\&quot; as SYS\n\n&#39; BQL kế thừa quyền quản lý WO của KST\nBQL --|&gt; KST\n\npackage \&quot;4. Bảo trì định kỳ (PM)\&quot; {\n    usecase \&quot;UC26: Quét QR Check-in hiện trường\&quot; as UC26\n    usecase \&quot;UC27: Điền Checklist động\&quot; as UC27\n    usecase \&quot;UC28: Chụp ảnh trước/sau\&quot; as UC28\n    usecase \&quot;UC29: Ghi nhận vật tư sử dụng\&quot; as UC29\n    \n    usecase \&quot;UC22: Cấu hình lịch bảo trì\&quot; as UC22\n    usecase \&quot;UC24: Xem danh sách Work Order\&quot; as UC24\n    usecase \&quot;UC25: Phân công KTV cho WO\&quot; as UC25\n    usecase \&quot;UC30: Nghiệm thu/từ chối WO\&quot; as UC30\n    usecase \&quot;UC31: Xem kết quả Checklist\&quot; as UC31\n    \n    usecase \&quot;UC23: Tự động sinh Work Order\&quot; as UC23\n}\n\nKTV --&gt; UC24\nKTV --&gt; UC26\nKTV --&gt; UC27\nKTV --&gt; UC28\nKTV --&gt; UC29\n\nKST --&gt; UC22\nKST --&gt; UC24\nKST --&gt; UC25\nKST --&gt; UC30\nKST --&gt; UC31\n\nSYS --&gt; UC23\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="Jsn1NDj1NjuvTaq5IqC4-5">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
