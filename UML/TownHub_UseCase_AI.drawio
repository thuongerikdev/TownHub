        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam usecase {\n    BackgroundColor White\n    BorderColor Black\n}\nskinparam actor {\n    BackgroundColor White\n    BorderColor Black\n}\n\nactor \&quot;Kỹ thuật viên\&quot; as KTV\nactor \&quot;Kỹ sư trưởng\&quot; as KST\nactor \&quot;Ban quản lý\&quot; as BQL\nactor \&quot;Kế toán\&quot; as KT\nactor \&quot;Hệ thống / IoT\&quot; as SYS\n\nKST --|&gt; KTV\nBQL --|&gt; KST\n\npackage \&quot;5. Quản lý kho vật tư\&quot; {\n    usecase \&quot;UC32: Xem tồn kho thực tế\&quot; as UC32\n    usecase \&quot;UC33: Xuất/nhập vật tư\&quot; as UC33\n    usecase \&quot;UC34: Chuyển kho ảo KTV\&quot; as UC34\n    \n    usecase \&quot;UC35: Kiểm kê kho định kỳ\&quot; as UC35\n    usecase \&quot;UC36: Cảnh báo tồn kho thấp\&quot; as UC36\n    usecase \&quot;UC37: Quản lý danh mục vật tư\&quot; as UC37\n}\n\nKTV --&gt; UC32\nKTV --&gt; UC33\nKTV --&gt; UC34\n\nKST --&gt; UC35\nKST --&gt; UC36\nKST --&gt; UC37\n\nKT --&gt; UC33\nSYS --&gt; UC36\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="Jsn1NDj1NjuvTaq5IqC4-6">
